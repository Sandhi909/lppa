Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Redirect GET requests that contain .php to clean URL ---
  # Only GET, to preserve POST data. Query string preserved via QSA.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/([^?\s]*)\.php(\?[^\s]*)?\s [NC]
  RewriteRule ^ /%1%2 [R=301,L,NE]

  # --- Internal rewrite: clean URL -> actual .php file ---
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

<FilesMatch "\.(sql|md)$">
  Require all denied
</FilesMatch>
